{
    "_comment": "Intel macOS（TARGET_ARCH=x86_64）便携包的依赖 pin 由 fork `pyproject.toml` 的 PEP 508 markers 生效，与 packages 里的 `pdf2zh @ git+...` 安装方式一致；请勿在此重复硬 pin，避免覆盖非 Intel 平台的依赖解析。",
    "pdf2zh": {
        "conda": {
            "python_version": "3.12",
            "packages": [
                "pdf2zh @ git+https://gh-proxy.com/https://github.com/BluesilveEmperor/PDFtranslate.git@main",
                "pypdf",
                "PyMuPDF",
                "flask",
                "numpy==2.2.0",
                "toml",
                "pdfminer.six==20250416",
                "packaging"
            ]
        },
        "uv": {
            "python_version": "3.12",
            "packages": [
                "pdf2zh @ git+https://gh-proxy.com/https://github.com/BluesilveEmperor/PDFtranslate.git@main",
                "pypdf",
                "PyMuPDF",
                "flask",
                "numpy==2.2.0",
                "toml",
                "pdfminer.six==20250416",
                "packaging"
            ]
        }
    },
    "pdf2zh_next": {
        "conda": {
            "python_version": "3.12",
            "packages": [
                "pdf2zh_next>=2.9.0,<3.0.0",
                "pypdf",
